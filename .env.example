# CiscoMan environment configuration (optional)
#
# The encryption key for stored device credentials is NEVER kept here.
# It is derived from your master password at login (PBKDF2). These values
# only tune behavior.

# Path to the local encrypted inventory database
CISCOMAN_DB_PATH=network_inventory.db

# Auto-logout after this many minutes of inactivity
CISCOMAN_SESSION_TIMEOUT_MIN=20

# Default SSH port used for scanning and connections
CISCOMAN_SSH_PORT=22

# Concurrency: how many devices to scan / execute against in parallel
CISCOMAN_SCAN_WORKERS=100
CISCOMAN_EXEC_WORKERS=8

# Per-connection timeouts (seconds)
CISCOMAN_SCAN_TIMEOUT=0.6
CISCOMAN_SSH_TIMEOUT=20
